# Copy to .env (chmod 600). Never commit the real file.

# Weather location (defaults: San Jose, CA, imperial units)
# CITY=San Jose
# LAT=37.3382
# LON=-121.8863
# WX_TZ=America/Los_Angeles
# UNITS=imperial

# Shared secret for the server-1 stats agent (generate: head -c 32 /dev/urandom | base64)
INGEST_TOKEN=
INGEST_FROM=10.10.10.21

# Mei (voice assistant). Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest              # Mei
# GEMINI_SUMMARY_MODEL=gemini-flash-lite-latest # News story summaries
# GEMINI_SEARCH=1   # Google Search grounding; needs a paid Gemini plan for current models

# Morning briefing from Mei, local time (WX_TZ). "off" to disable. Button 1 on Mei's page asks for one any time.
# BRIEFING_AT=07:00
# BRIEFING_LANG=English

# Calendar page: one or more secret iCal links (space separated). Set it with tools/set-calendar-url.sh
# so the link never lands in your shell history.
CALENDAR_ICS=

# Spotify (Authorization Code + PKCE, no client secret). Redirect URI: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
