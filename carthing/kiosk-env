# /var/lib/hub/kiosk-env on the Car Thing.
# Desk hub served by the brain over USB. Lives on the data partition, which Nocturne does not reset on boot.
# /etc/default/chromium-kiosk points KIOSK_ENV_OVERRIDE_FILE here (see docs/SETUP.md).
KIOSK_URL=http://10.42.1.6:8787/
# Helpers that live and die with the kiosk: brightness from the quick menu, microphone for Mei.
[ -x /var/lib/hub/brightness-sync.sh ] && setsid /var/lib/hub/brightness-sync.sh >/dev/null 2>&1 </dev/null &
[ -x /var/lib/hub/voice-agent.sh ] && setsid /var/lib/hub/voice-agent.sh >/dev/null 2>&1 </dev/null &
