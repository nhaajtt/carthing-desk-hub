# /var/lib/hub/kiosk-env on the Car Thing.
# Desk hub served by the brain over USB. Lives on the data partition, which Nocturne does not reset on boot.
# /etc/default/chromium-kiosk points KIOSK_ENV_OVERRIDE_FILE here (see docs/SETUP.md).
# In the car there is no server 2: show the copy of the page that phonelink serves on the Car Thing itself.
# Either page moves to the other by itself when server 2 comes or goes.
KIOSK_URL=http://127.0.0.1:5056/
for _ in 1 2 3; do
  if wget -q -T 3 -O /dev/null http://10.42.1.6:8787/health 2>/dev/null; then KIOSK_URL=http://10.42.1.6:8787/; break; fi
  sleep 1
done
# Helpers that live and die with the kiosk: brightness from the quick menu, microphone for Mei,
# a watcher that reloads the kiosk if it got stuck on an error page, and the iPhone link over Bluetooth.
[ -x /var/lib/hub/brightness-sync.sh ] && setsid /var/lib/hub/brightness-sync.sh >/dev/null 2>&1 </dev/null &
[ -x /var/lib/hub/voice-agent.sh ] && setsid /var/lib/hub/voice-agent.sh >/dev/null 2>&1 </dev/null &
[ -x /var/lib/hub/kiosk-watch.sh ] && setsid /var/lib/hub/kiosk-watch.sh >/dev/null 2>&1 </dev/null &
[ -x /var/lib/hub/phonelink ] && setsid /var/lib/hub/phonelink >/run/hub-phone.log 2>&1 </dev/null &
